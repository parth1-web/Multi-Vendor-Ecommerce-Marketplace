{
  // One click starts the whole system: the API with its database, and the site in front of it.
  //
  // F5 (Run > Run Without Debugging) or Ctrl+Shift+B starts both, side by side, and keeps them
  // running until you stop them. The ports here are the ones the code defaults to, so nothing has
  // to be configured before the first run.
  //
  // Prerequisite, once: PostgreSQL on localhost:5432 with a role postgres/postgres. The API creates
  // the marketplace database, applies the migrations and seeds the demo catalogue on first start.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Full stack (API + site)",
      "detail": "Starts the API on :5000 and the site on :3000, side by side. Stop to shut both down.",
      "dependsOn": ["API only", "Site only"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Wait for the API, then open the site",
      "detail": "For when the terminals are open: opens the site once the API answers.",
      "type": "shell",
      "dependsOn": ["API only"],
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" },
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/wait-for-api.ps1"
      ]
    },
    {
      "label": "API only",
      "detail": "The API on :5000, with migrations and the demo catalogue.",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/backend/src/Marketplace.API", "--urls", "http://localhost:5000"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "DOTNET_ENVIRONMENT": "Development" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^\\s*(\\w+)\\s+error\\s+(\\w+):\\s+(.+) \\[(\\S+)\\]$",
            "file": 4,
            "location": 1,
            "message": 3
          }
        ]
      }
    },
    {
      "label": "Clear the site build cache",
      "detail": "Removes .next, which the dev server, the production build and the type check all share.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Remove-Item .next -Recurse -Force -ErrorAction SilentlyContinue; Write-Host Cleared the site build cache."
      ],
      "options": { "cwd": "${workspaceFolder}/frontend/marketplace-web" },
      "problemMatcher": []
    },
    {
      "label": "Site only",
      "detail": "The site on :3000, against an API you started yourself.",
      "type": "process",
      "dependsOrder": "sequence",
      "dependsOn": ["Clear the site build cache"],
      "command": "npm",
      "args": ["run", "dev", "--prefix", "${workspaceFolder}/frontend/marketplace-web"],
      "options": { "cwd": "${workspaceFolder}/frontend/marketplace-web" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "eslint",
        "fileLocation": ["relative", "${workspaceFolder}/frontend/marketplace-web"],
        "pattern": [
          {
            "regexp": "^(.+):(\\d+):(\\d+)\\s+(.+?)\\s*\\((.+?)\\)$",
            "file": 1,
            "location": 2,
            "message": [4, 5]
          }
        ]
      }
    },
    {
      "label": "Install the site",
      "detail": "npm install. Only needed once, and only if node_modules is missing.",
      "type": "shell",
      "command": "npm",
      "args": ["install", "--prefix", "${workspaceFolder}/frontend/marketplace-web"],
      "options": { "cwd": "${workspaceFolder}/frontend/marketplace-web" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Restore packages",
      "detail": "dotnet restore, so the first run does not have to.",
      "type": "shell",
      "command": "dotnet",
      "args": ["restore", "${workspaceFolder}/backend/Marketplace.sln"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Test the API",
      "detail": "125 unit tests and 133 integration tests, against a real PostgreSQL database.",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/backend/Marketplace.sln", "--nologo"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": {
        "owner": "dotnet",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^\\s*(\\w+)\\s+error\\s+(\\w+):\\s+(.+) \\[(\\S+)\\]$",
            "file": 4,
            "location": 1,
            "message": 3
          }
        ]
      },
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Check the site",
      "detail": "TypeScript, then lint, then a production build.",
      "type": "shell",
      "command": "npm",
      "args": ["run", "verify", "--prefix", "${workspaceFolder}/frontend/marketplace-web"],
      "options": { "cwd": "${workspaceFolder}/frontend/marketplace-web" },
      "problemMatcher": []
    },
    {
      "label": "Check everything",
      "detail": "The API's tests and the site's checks, one after the other.",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": ["Test the API", "Check the site"],
      "problemMatcher": []
    },
    {
      "label": "Reset the demo data",
      "detail": "Drops and recreates the database, then the API rebuilds it on the next start.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/reset-data.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
