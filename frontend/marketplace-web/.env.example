# Local development points at the API on its default HTTPS-free port.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the API may send the browser back to after a payment. Must match Payment:FrontendBaseUrl.
NEXT_PUBLIC_PAYMENT_RETURN_URL=http://localhost:3000/checkout

# SignalR hub on the API.
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs/marketplace