{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=marketplace;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Jwt": {
    "Key": "local-dev-signing-key-not-for-production-use",
    "Issuer": "marketplace-api",
    "Audience": "marketplace-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstancePrefix": "marketplace:"
  },
  "Payment": {
    "DefaultProvider": "Mock",
    "WebhookSecret": "development-webhook-secret",
    "Gateways": {
      "Khalti": { "PublicKey": "", "SecretKey": "", "BaseUrl": "https://dev.khalti.com/api" },
      "ESewa": { "MerchantId": "", "SecretKey": "", "BaseUrl": "https://uat.esewa.com.np" },
      "Stripe": { "SecretKey": "", "WebhookSecret": "", "BaseUrl": "https://api.stripe.com" }
    }
  },
  "Marketplace": {
    "CommissionRate": 10.0,
    "Currency": "USD",
    "TaxRate": 0.0,
    "FreeShippingThreshold": 150.00,
    "StandardShippingCost": 9.99,
    "ReservationMinutes": 15,
    "LowStockThreshold": 5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}
